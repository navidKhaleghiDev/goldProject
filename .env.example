NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Comma-separated additional exact frontend origins, if needed.
# WEB_ORIGINS=http://127.0.0.1:3000,http://192.168.1.8:3000
NEXT_PUBLIC_API_URL=/api
# Backend URL as seen by the Next.js server, not by the browser.
API_INTERNAL_URL=http://127.0.0.1:4000
API_PORT=4000
DATABASE_URL=postgres://sheri_gold:sheri_gold@localhost:5432/sheri_gold
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_OTP_ENABLED=true
DEMO_OTP_CODE=123456
LEGACY_PASSWORD_AUTH_ENABLED=false
# Stable independent secret of at least 32 characters; required in production.
# Keep it across deployments, or existing bank account details cannot be decrypted.
# BANK_ACCOUNT_ENCRYPTION_KEY=replace-with-a-stable-random-secret-at-least-32-characters
ADMIN_PHONE=09120000000
ADMIN_FULL_NAME="مدیر"
WHATSAPP_PHONE=989120000000
TELEGRAM_USERNAME=sheri_gold
DEMO_GOLD_PRICE_TOMAN=7240000
DEMO_SILVER_PRICE_TOMAN=115000

# Explicit private demonstration mode; forbidden in production.
TRADING_DEMO_ENABLED=true
GOLD_PURITY=18k
PRICE_LOCK_SECONDS=60
PAYMENT_WINDOW_SECONDS=3600
RECEIPT_CORRECTION_SECONDS=120
MIN_TRADE_MG=1
MAX_TRADE_MG=100000
PAYMENT_INSTRUCTIONS="حالت آزمایشی؛ وجه واقعی واریز نکنید."
RECEIPT_DIRECTORY=./private-receipts
